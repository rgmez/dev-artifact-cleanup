{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development artifact cleanup audit manifest",
  "type": "object",
  "required": ["schemaVersion", "mode", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["audit", "execute"] },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "class", "sizeBytes", "evidence", "risk", "proposedAction", "approved"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string", "pattern": "^/" },
          "class": { "enum": ["build-output", "test-result", "worktree", "cache", "archive", "simulator", "log", "other"] },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "gitState": { "type": "string" },
          "ownership": { "type": "string" },
          "risk": { "enum": ["safe-candidate", "requires-review", "retain"] },
          "proposedAction": { "enum": ["audit-only", "remove", "archive", "preserve"] },
          "approved": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
